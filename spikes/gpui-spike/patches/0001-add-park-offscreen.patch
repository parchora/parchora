+    fn park_offscreen(&mut self, park: bool) {
+        // Vendored (DEC-59)：与下方 activate() 同一 async + closed 守卫模式；
+        // -32000/-31000 为经典屏外停放点，unpark 用 setFrame:display: 全量还原（位置+尺寸）。
+        // 锁纪律：AppKit setFrame* 会同步回调 NSWindowDelegate（didMove/didResize），
+        // delegate 亦会 lock 同一 MacWindowState——objc 调用一律不得持锁执行，
+        // 否则同线程重入 parking_lot Mutex 即主队列死锁（真机 spike 已复现）。
+        let this = Arc::clone(&self.0);
+        let window = this.lock().native_window;
+        let closed = this.lock().closed.clone();
+        let executor = this.lock().foreground_executor.clone();
+        executor
+            .spawn(async move {
+                if closed.load(Ordering::Acquire) {
+                    return;
+                }
+                let window = unsafe { &*window.cast::<Objc2NSWindow>() };
+                if park {
+                    let frame = window.frame();
+                    window.setFrameOrigin(Objc2NSPoint::new(-32000., -31000.));
+                    this.lock().parked_frame = Some(frame);
+                } else {
+                    // 注意：临时 guard 只允许跨 take() 本身，不得横跨 setFrame——
+                    // if let Some(f) = this.lock().x.take() { objc(...) } 的 guard
+                    // 生存期会延伸到 else 分支结束，重入 delegate 锁即死锁。
+                    let frame = this.lock().parked_frame.take();
+                    if let Some(frame) = frame {
+                        window.setFrame_display(frame, true);
+                    }
+                }
+            })
+            .detach();
+    }
